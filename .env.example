# Banco de dados (Postgres local via docker compose ou Neon em produção)
DATABASE_URL=postgres://hospedagens:hospedagens@localhost:5432/hospedagens

# Better Auth — gere um segredo com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-forte-com-32-caracteres
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 (fotos de perfil). Opcional: sem estas variáveis o upload fica
# desativado. Passo a passo em docs/setup/cloudflare-r2.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pública do bucket (domínio próprio ou r2.dev), sem barra no final
R2_PUBLIC_URL=
# Só para testes com emulador S3 local; em produção fica vazio
R2_ENDPOINT=
